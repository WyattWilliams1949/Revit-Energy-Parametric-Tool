<Window x:Class="RevitAddin.EffectiveRValueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculate Effective R-Value" Height="700" Width="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" x:Key="Input">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Lbl">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Calculate Effective R-Value" FontSize="18"
                   FontFamily="Segoe UI Light" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                   Text="Select the wall types to analyze, enter thermal properties, and click Calculate. A new wall type with the effective R-value will be created and applied."/>

        <!-- Wall type multi-select -->
        <Border Grid.Row="2" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="lbWallTypes" SelectionMode="Multiple"
                     Background="Transparent"
                     BorderThickness="0" FontFamily="Segoe UI" FontSize="12"/>
        </Border>

        <!-- Thermal inputs -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Stud R-Value (h·ft²·°F/BTU):" Style="{StaticResource Lbl}" Margin="0,4"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtRStud" Text="4.38" Style="{StaticResource Input}" Margin="6,4,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Insulation R-Value:" Style="{StaticResource Lbl}" Margin="0,4"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtRIns" Text="13" Style="{StaticResource Input}" Margin="6,4,0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Window R-Value:" Style="{StaticResource Lbl}" Margin="0,4"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtRWin" Text="3" Style="{StaticResource Input}" Margin="6,4,0,4"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Door R-Value:" Style="{StaticResource Lbl}" Margin="0,4"/>
                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="txtRDoor" Text="5" Style="{StaticResource Input}" Margin="6,4,0,4"/>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Framing Factor (%):" Style="{StaticResource Lbl}" Margin="0,4"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtFF" Text="25" Style="{StaticResource Input}" Margin="6,4,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Density (lb/ft³):" Style="{StaticResource Lbl}" Margin="0,4"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtDensity" Text="25" Style="{StaticResource Input}" Margin="6,4,0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Specific Heat (BTU/lb·°F):" Style="{StaticResource Lbl}" Margin="0,4"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtSpecificHeat" Text="0.2" Style="{StaticResource Input}" Margin="6,4,0,4"/>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="lblStatus" FontSize="11"
                   Margin="0,8,0,6" TextWrapping="Wrap" Visibility="Collapsed"/>

        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="&lt; Back" Style="{StaticResource Btn}" Click="BtnBack_Click"/>
            <Button Grid.Column="2" Content="Calculate &amp; Apply" Style="{StaticResource Btn}"
                    Click="BtnCalculate_Click"/>
        </Grid>
    </Grid>
</Window>
